# Copy to .dev.vars for local `wrangler dev`. Never commit real secrets.
SESSION_SECRET=dev-session-secret-change-me
APP_ORIGIN=http://localhost:5173
ENVIRONMENT=development
# RESEND_API_KEY=re_xxx
# MAGIC_FROM_EMAIL=PyTyping <signin@yourdomain>
# POLAR_ACCESS_TOKEN=polar_at_xxx
# POLAR_WEBHOOK_SECRET=polar_whs_xxx
# POLAR_PRODUCT_ID=prod_xxx
# POLAR_API_BASE=https://sandbox-api.polar.sh

# Operator console (never ship these values; generate a unique path per environment)
# node scripts/hash-ops-password.mjs 'your-password'
# OPS_PATH=/replace-with-32-plus-random-bytes-hex
# OPS_USERNAME=operator
# OPS_PASSWORD_SALT=
# OPS_PASSWORD_HASH=
# OPS_TOTP_SECRET=
# OPS_ALERT_EMAIL=
# OPS_IP_ALLOWLIST=127.0.0.1
